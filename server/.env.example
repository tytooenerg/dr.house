# Copy to .env and fill in for production use. All are optional in development —
# sensible (insecure) defaults are used automatically when unset.

# Secret used to sign JWTs. Required in production; a warning is logged if unset.
JWT_SECRET=

# Port the API listens on. Defaults to 4000.
PORT=4000

# SQLite database file path. Defaults to server/data/lastro.db. Use ":memory:" for tests.
DB_PATH=

# Optional: enables the AI assistant to call Claude instead of using canned answers.
ANTHROPIC_API_KEY=

# Comma-separated list of allowed CORS origins. Defaults to http://localhost:5173.
CORS_ORIGINS=http://localhost:5173

# Optional: pino log level (trace/debug/info/warn/error). Defaults to info.
LOG_LEVEL=

# Optional: enables Sentry error tracking. Errors are just logged when unset.
SENTRY_DSN=

# Optional: enables Redis pub/sub relay for the marketplace WebSocket feed —
# only relevant if you run more than one API process. A single process works
# fine without this.
REDIS_URL=

# Optional SMTP transport for real notification emails (aceite/disputa events).
# When unset, emails are logged instead of sent — the app works fully without them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Lastro <no-reply@lastro.demo>

# Optional: enables real Stripe subscription billing (checkout, customer portal,
# webhooks). When STRIPE_SECRET_KEY is unset, plan changes are simulated locally —
# instant, no real charge — so the whole product (including plan-gated features) is
# still fully demoable without a Stripe account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_EMPRESARIAL=
