# Copy to .env and fill in for production use. All are optional in development —
# sensible (insecure) defaults are used automatically when unset.

# Secret used to sign JWTs. Required in production; a warning is logged if unset.
JWT_SECRET=

# Port the API listens on. Defaults to 4000.
PORT=4000

# Base URL the SPA is served from — used to build the accept-invite link mailed to team
# members (routes/profile.ts POST /team/invite) and where the Google OAuth callback
# (routes/auth.ts) redirects the browser back to after a real login. Defaults to the Vite
# dev server's URL.
APP_URL=http://localhost:5173

# SQLite database file path. Defaults to server/data/lastro.db. Use ":memory:" for tests.
DB_PATH=

# Optional: enables real Claude-powered features — the chat assistant, NF-e/contract
# reading, the AI risk narrative, the dispute/sinistro copilots, PLD second opinion, the
# reasoning text in the Compliance AI Engine, AND the 10 agentic AI agents (Emissão,
# Underwriting, PLD, Cobrança, Disputas & Sinistros, Regulatório, Onboarding/KYB, Auto-Bid,
# Suporte, Comercial — see README "Agentes de IA (agentic)"). The Compliance AI Engine's
# score itself is always deterministic and works without this key — only its
# human-readable explanation needs it. Every single-shot feature falls back to canned copy
# / no extraction / the original result when this isn't set; every agent falls back to an
# honest "modo simulado" run that investigates and acts on nothing.
ANTHROPIC_API_KEY=

# Comma-separated list of allowed CORS origins. Defaults to http://localhost:5173.
CORS_ORIGINS=http://localhost:5173

# Optional: pino log level (trace/debug/info/warn/error). Defaults to info.
LOG_LEVEL=

# Optional: enables Sentry error tracking. Errors are just logged when unset.
SENTRY_DSN=

# Optional: enables Redis pub/sub relay for the marketplace WebSocket feed AND the
# real cache backend (lib/cache.ts, e.g. GET /api/public/stats) — only relevant if
# you run more than one API process. A single process works fine without this: the
# WS feed just runs its own local interval, and the cache falls back to an
# in-memory TTL map.
REDIS_URL=

# Optional SMTP transport for real notification emails (aceite/disputa events).
# When unset, emails are logged instead of sent — the app works fully without them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Lastro <no-reply@lastro.demo>

# Optional: enables real Stripe subscription billing (checkout, customer portal,
# webhooks). When STRIPE_SECRET_KEY is unset, plan changes are simulated locally —
# instant, no real charge — so the whole product (including plan-gated features) is
# still fully demoable without a Stripe account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_EMPRESARIAL=

# Optional: enables a real Pix payment rail (server/src/lib/paymentRail.ts) — real
# cobrança/QR code generation, deposit confirmation via webhook, and real Pix payouts
# on withdraw, against a licensed PSP's actual BACEN "API Pix" implementation. When unset,
# deposits/saques run in a clearly-labeled simulated mode (Conta & Liquidação shows a
# "Confirmar (simulado)" button instead of waiting for the real webhook) — you need an
# actual PSP contract for this to move real money, this repo can't provide one for you.
PIX_PSP_BASE_URL=
PIX_PSP_CLIENT_ID=
PIX_PSP_CLIENT_SECRET=
PIX_CHAVE_RECEBEDOR=
# No BACEN-standard shape exists for outbound Pix send — set this to whatever path your
# specific PSP documents for it. Defaults to "/pix/enviar".
PIX_PAYOUT_PATH=

# Optional: enables real registration + duplicidade-check calls against each registradora
# (lib/registradoras.ts). Each is a private commercial contract, not a public standard
# like Pix — the request/response shape here is a reasonable generic REST contract meant
# to be adjusted once a real integration agreement gives you the registradora's actual API
# docs. Unset (any/all) falls back to the existing simulated registration flow.
REGISTRADORA_CERC_API_URL=
REGISTRADORA_CERC_API_KEY=
REGISTRADORA_B3_API_URL=
REGISTRADORA_B3_API_KEY=
REGISTRADORA_NUCLEA_API_URL=
REGISTRADORA_NUCLEA_API_KEY=
REGISTRADORA_GRAFENO_API_URL=
REGISTRADORA_GRAFENO_API_KEY=

# Optional: screens KYB submissions against OFAC's real, free, public SDN sanctions list
# AND the UN Security Council Consolidated List (server/src/lib/sanctionsFeed.ts) instead
# of only the fictitious demo watchlist. No commercial account needed for either — off by
# default purely to keep local dev/CI fast/offline. Note the UN list isn't just "nice to
# have": UN sanctions are directly, self-executingly binding in Brazil (Lei 13.810/2019),
# unlike OFAC/EU which only become practically relevant once a foreign counterparty is
# involved.
SANCTIONS_LIVE_FEED=false
# Optional overrides for the source URLs above — only needed if the defaults change or
# you want to point at a mirror.
OFAC_SDN_CSV_URL=
UN_SC_XML_URL=

# Optional: screens KYB submissions against a licensed commercial PLD/KYC provider first
# (Serasa Compliance, Quod, Neoway, etc. — whatever you're actually contracted with).
# Requires a real commercial account this repo can't provide; unset = skipped.
PLD_PROVIDER_API_URL=
PLD_PROVIDER_API_KEY=

# Optional: blends a real external credit bureau score (Serasa Experian, Boa Vista SCPC,
# Quod — server/src/lib/creditBureau.ts) into Análise de Risco and the public score
# endpoint, on top of the internal + network-signal score. Requires a real commercial
# bureau account this repo can't provide; unset = score stays internal + network only.
BUREAU_API_URL=
BUREAU_API_KEY=

# Optional: enables real WhatsApp/SMS notifications via Twilio (server/src/lib/smsNotifier.ts)
# — aceite-deadline reminders (lib/aceiteReminder.ts) and every other notification event,
# for users who opt in from Perfil. When unset, messages are logged instead of sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# Optional: overrides the approximate per-million-token USD rate used to estimate cost in
# the admin "Uso de IA" panel (server/src/db/claudeUsage.ts) — the real token counts always
# come from the Anthropic API's own usage field, only the $/token conversion is a
# configurable estimate. Defaults to $3 input / $15 output per million tokens.
CLAUDE_COST_INPUT_PER_MTOK_USD=
CLAUDE_COST_OUTPUT_PER_MTOK_USD=

# Optional: enables a real judicial-records/litigation-history check (execuções,
# falência/recuperação judicial, protestos) by CNPJ, blended as a real signal into the
# Compliance AI Engine (server/src/lib/judicialRecords.ts). Requires a real commercial
# contract with a provider like Escavador or Jusbrasil this repo can't provide — there is
# no free official public API for this in Brazil (unlike OFAC's sanctions list). Unset =
# this factor is simply never added to the compliance score, nothing is faked.
JUDICIAL_RECORDS_API_URL=
JUDICIAL_RECORDS_API_KEY=

# Optional: overrides the per-partner-API-key rate limit on /api/v1 with one fixed number
# for every key. Unset (the default) uses real tiered limits instead
# (auth/apiKey.ts computeApiKeyLimitPerMin): 60/min for sandbox (test-mode) keys and
# Básico-plan live keys, 150/min for Pro, 400/min for Empresarial, 200/min for standalone
# data-product keys (Score API / PLD Screening API) regardless of subscription plan.
API_RATE_LIMIT_PER_MIN=

# Optional: comma-separated retry delays in ms for failed webhook deliveries.
# Defaults to "0,30000,300000,1800000" (immediate / 30s / 5min / 30min).
WEBHOOK_RETRY_DELAYS_MS=

# Optional: enables a real boleto deposit rail (server/src/lib/boletoRail.ts) alongside
# the existing PIX deposit flow, via a licensed banking-as-a-service / boleto PSP (e.g.
# a bank's or fintech's boleto emission API this repo can't provide). Requires a real
# commercial contract; unset = deposits fall back to the honestly-labeled simulated
# boleto (a fake linha digitável you confirm manually, same as simulated PIX).
BOLETO_PSP_BASE_URL=
BOLETO_PSP_CLIENT_ID=
BOLETO_PSP_CLIENT_SECRET=
BOLETO_CEDENTE_CNPJ=

# Optional: blends a real Open Finance cash-flow signal (receita média mensal,
# volatilidade) into Análise de Risco (server/src/lib/openFinance.ts), on top of the
# internal + network + bureau score. Requires a real Open Finance aggregator account
# (e.g. Belvo, Pluggy, Quanto) this repo can't provide — and covers only the data-pull
# side, not the consent-redirect UX a production integration would also need. Unset =
# this factor is simply never added, nothing is faked.
OPEN_FINANCE_API_URL=
OPEN_FINANCE_API_KEY=

# Optional: enables a real biometric prova-de-vida / liveness check on KYC selfie
# uploads (server/src/lib/biometricKyc.ts), via a licensed provider (e.g. Unico,
# idwall, Acesso Digital) this repo can't provide. Requires a real commercial contract;
# unset = selfie uploads are stored but never marked "Verificado" — the KYC checklist
# item stays honestly Pendente, nothing is faked.
BIOMETRIC_KYC_API_URL=
BIOMETRIC_KYC_API_KEY=

# Optional: enables real e-signature sending for reviewed legal drafts
# (server/src/lib/esignature.ts) — a document an admin already marked "revisado" can be
# sent to a real signer for a real signature instead of just sitting as approved text.
# Generic REST shape (not tied to one vendor's exact API) — point ESIGNATURE_API_URL at
# an adapter/proxy in front of your actual provider (Clicksign, DocuSign, D4Sign, Adobe
# Sign) if its contract differs; unset = every send is simulated and clearly labeled as such.
ESIGNATURE_API_URL=
ESIGNATURE_API_KEY=

# Optional: enables real Web Push notifications (server/src/lib/webPush.ts) — a real
# W3C/IETF standard (RFC 8030 push protocol + RFC 8292 VAPID), not a vendor-specific API,
# so unlike ESIGNATURE_* above there's nothing to adapt per-provider. Generate a real pair
# with `npx web-push generate-vapid-keys` (from server/). Unset = every send is a logged
# no-op and the browser opt-in toggle in Perfil stays hidden.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@lastro.demo

# Optional: enables a real TED payment rail (server/src/lib/tedRail.ts) alongside Pix
# and boleto — for large institutional transfers. TED_PSP_* plugs in a real
# banking-as-a-service provider (dedicated virtual account, real-time webhook
# confirmation). Without it, LASTRO_TED_* shows Lastro's own real receiving account for
# deposits, with confirmation done manually by an admin (GET/POST /admin/ted/*) — there is
# no honest way to auto-confirm a TED without either. Neither set = fully simulated demo
# bank data.
TED_PSP_BASE_URL=
TED_PSP_CLIENT_ID=
TED_PSP_CLIENT_SECRET=
LASTRO_TED_BANCO=
LASTRO_TED_AGENCIA=
LASTRO_TED_CONTA=
LASTRO_TED_CNPJ=

# Optional: enables a real stablecoin settlement rail (server/src/lib/stablecoinRail.ts) —
# a fourth deposit/withdraw method alongside Pix/boleto/TED, aimed mainly at a non-resident
# investor funding a position without a manual SWIFT/câmbio step, and settlement outside
# Pix/TED banking hours. STABLECOIN_PSP_* plugs in a real custodial/VASP provider (dedicated
# deposit address per user, real-time webhook confirmation). Without it,
# LASTRO_STABLECOIN_WALLET_ADDRESS shows Lastro's own real receiving wallet, with
# confirmation done manually by an admin (GET/POST /admin/stablecoin/*) — same reasoning as
# TED above: there's no honest way to auto-confirm an on-chain transfer without either.
# Neither set = fully simulated demo wallet data. IMPORTANT: unlike Pix's PSP (already
# BACEN-licensed), custodying/converting stablecoin on behalf of third parties is itself an
# activity the Banco Central regulates (Lei 14.478/2022 + 2025 VASP rules) — STABLECOIN_PSP_*
# must point at an already-authorized custodial/VASP partner, this repo can't make Lastro
# one just by setting an env var.
STABLECOIN_PSP_BASE_URL=
STABLECOIN_PSP_CLIENT_ID=
STABLECOIN_PSP_CLIENT_SECRET=
LASTRO_STABLECOIN_WALLET_ADDRESS=
# Which stablecoin/network Lastro settles in — a platform-wide choice, not per-user.
# Defaults to USDC on Polygon.
STABLECOIN_ASSET=
STABLECOIN_NETWORK=

# Optional: enables real "Entrar com Google" (server/src/lib/googleOAuth.ts) — a real
# OAuth 2.0 authorization-code flow against Google's actual endpoints. Get these from a
# real OAuth client in Google Cloud Console (APIs & Services → Credentials). Unlike every
# other real-when-configured integration in this repo, there's no simulated fallback:
# faking a third party's identity verification would be dishonest, so the "Continuar com
# Google" button is simply hidden when unset (GET /api/auth/google/config).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: overrides the computed callback URL (recommended in production, especially
# behind a reverse proxy) — must exactly match the redirect URI registered in Google
# Cloud Console. Defaults to `{request protocol+host}/api/auth/google/callback`.
GOOGLE_OAUTH_REDIRECT_URI=

# Optional: tune the automated SQLite backup job (server/src/lib/backup.ts), which is
# otherwise always on (real disk, not simulated) whenever DB_PATH isn't ':memory:'.
# Defaults: snapshot every 6h (21600000ms), keep the most recent 28 (~1 week at that
# cadence). BACKUP_OFFSITE_CMD, if set, is run as `<cmd> <path-to-snapshot>` after each
# local snapshot — e.g. "aws s3 cp" / "rclone copy" — for shipping a copy off-instance;
# there's no cloud storage credential this repo can honestly provide, so nothing ships by
# default and backups otherwise stay local-disk only.
BACKUP_INTERVAL_MS=
BACKUP_RETENTION_COUNT=
BACKUP_OFFSITE_CMD=

# Optional: enables real enterprise "Entrar com SSO corporativo" (server/src/lib/samlSso.ts)
# — SP-initiated SAML 2.0 against a real identity provider (Okta, Azure AD, Google
# Workspace, OneLogin...). SAML_IDP_METADATA_XML is the IdP's metadata XML document as a
# single-line string (export it from the IdP admin console); SAML_SP_ENTITY_ID is this
# app's own SP entity ID, whatever you register with that IdP. Same reasoning as Google
# OAuth above: no simulated fallback, since faking a third party's signed identity
# assertion would be dishonest — the button is simply hidden when unset (GET
# /api/auth/saml/config). The inbound assertion's signature is verified for real against
# the IdP's real certificate from its metadata (via the samlify library), independent of
# whether these env vars are set from a real IdP or a self-hosted test one.
SAML_IDP_METADATA_XML=
SAML_SP_ENTITY_ID=
# Optional: overrides the computed Assertion Consumer Service (ACS) URL the IdP posts the
# assertion back to (recommended in production, especially behind a reverse proxy) — must
# exactly match what's registered with the IdP. Defaults to
# `{request protocol+host}/api/auth/saml/acs`.
SAML_SP_ACS_URL=

# Optional: enables real distributed tracing (server/src/lib/tracing.ts) via OpenTelemetry.
# OTEL_EXPORTER_OTLP_ENDPOINT is a real OTLP/HTTP collector endpoint (e.g. a local Jaeger
# `http://localhost:4318/v1/traces`, Grafana Tempo, Honeycomb, etc.) — when unset, no SDK is
# started at all and every span call in the codebase is a documented no-op (the OpenTelemetry
# API's own default), costing nothing. OTEL_SERVICE_NAME overrides the reported service name
# (defaults to "lastro-api").
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

# Not read at server startup — these are only for the one-off `npm run create-admin
# --workspace=server` bootstrap script (server/src/scripts/createAdmin.ts), the real way to
# get the first admin account on a fresh production database once seedIfEmpty() refuses to
# auto-create admin@lastro.demo under NODE_ENV=production (see SEED_DEMO_DATA below). Set
# these as one-off env vars on the command that runs the script, not as a standing part of
# the app's own runtime config — see the script's own header comment / DEPLOY.md for the
# exact invocation. ADMIN_COMPANY is optional.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=
ADMIN_COMPANY=

# Also not read at server startup — a one-off override for db/seed.ts's own production
# guard: NODE_ENV=production skips creating the demo accounts (including admin@lastro.demo,
# whose password is publicly documented in this README) on an empty database, unless this is
# explicitly set to "true" — the one legitimate case being a public sales-demo environment
# that happens to run the production image but never holds real data.
SEED_DEMO_DATA=
