# Copy to .env and fill in for production use. All are optional in development —
# sensible (insecure) defaults are used automatically when unset.

# Secret used to sign JWTs. Required in production; a warning is logged if unset.
JWT_SECRET=

# Port the API listens on. Defaults to 4000.
PORT=4000

# Base URL the SPA is served from — used to build the accept-invite link mailed to team
# members (routes/profile.ts POST /team/invite). Defaults to the Vite dev server's URL.
APP_URL=http://localhost:5173

# SQLite database file path. Defaults to server/data/lastro.db. Use ":memory:" for tests.
DB_PATH=

# Optional: enables real Claude-powered features — the chat assistant, NF-e/contract
# reading, the AI risk narrative, the dispute/sinistro copilots, PLD second opinion, and
# the reasoning text in the Compliance AI Engine (see README "Claude-assisted features").
# The Compliance AI Engine's score itself is always deterministic and works without this
# key — only its human-readable explanation needs it. Every other feature falls back to
# canned copy / no extraction / the original result when this isn't set.
ANTHROPIC_API_KEY=

# Comma-separated list of allowed CORS origins. Defaults to http://localhost:5173.
CORS_ORIGINS=http://localhost:5173

# Optional: pino log level (trace/debug/info/warn/error). Defaults to info.
LOG_LEVEL=

# Optional: enables Sentry error tracking. Errors are just logged when unset.
SENTRY_DSN=

# Optional: enables Redis pub/sub relay for the marketplace WebSocket feed —
# only relevant if you run more than one API process. A single process works
# fine without this.
REDIS_URL=

# Optional SMTP transport for real notification emails (aceite/disputa events).
# When unset, emails are logged instead of sent — the app works fully without them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Lastro <no-reply@lastro.demo>

# Optional: enables real Stripe subscription billing (checkout, customer portal,
# webhooks). When STRIPE_SECRET_KEY is unset, plan changes are simulated locally —
# instant, no real charge — so the whole product (including plan-gated features) is
# still fully demoable without a Stripe account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_EMPRESARIAL=

# Optional: enables a real Pix payment rail (server/src/lib/paymentRail.ts) — real
# cobrança/QR code generation, deposit confirmation via webhook, and real Pix payouts
# on withdraw, against a licensed PSP's actual BACEN "API Pix" implementation. When unset,
# deposits/saques run in a clearly-labeled simulated mode (Conta & Liquidação shows a
# "Confirmar (simulado)" button instead of waiting for the real webhook) — you need an
# actual PSP contract for this to move real money, this repo can't provide one for you.
PIX_PSP_BASE_URL=
PIX_PSP_CLIENT_ID=
PIX_PSP_CLIENT_SECRET=
PIX_CHAVE_RECEBEDOR=
# No BACEN-standard shape exists for outbound Pix send — set this to whatever path your
# specific PSP documents for it. Defaults to "/pix/enviar".
PIX_PAYOUT_PATH=

# Optional: enables real registration + duplicidade-check calls against each registradora
# (lib/registradoras.ts). Each is a private commercial contract, not a public standard
# like Pix — the request/response shape here is a reasonable generic REST contract meant
# to be adjusted once a real integration agreement gives you the registradora's actual API
# docs. Unset (any/all) falls back to the existing simulated registration flow.
REGISTRADORA_CERC_API_URL=
REGISTRADORA_CERC_API_KEY=
REGISTRADORA_B3_API_URL=
REGISTRADORA_B3_API_KEY=
REGISTRADORA_NUCLEA_API_URL=
REGISTRADORA_NUCLEA_API_KEY=
REGISTRADORA_GRAFENO_API_URL=
REGISTRADORA_GRAFENO_API_KEY=

# Optional: screens KYB submissions against OFAC's real, free, public SDN sanctions list
# (server/src/lib/sanctionsFeed.ts) instead of only the fictitious demo watchlist. No
# commercial account needed — off by default purely to keep local dev/CI fast/offline.
SANCTIONS_LIVE_FEED=false

# Optional: screens KYB submissions against a licensed commercial PLD/KYC provider first
# (Serasa Compliance, Quod, Neoway, etc. — whatever you're actually contracted with).
# Requires a real commercial account this repo can't provide; unset = skipped.
PLD_PROVIDER_API_URL=
PLD_PROVIDER_API_KEY=

# Optional: blends a real external credit bureau score (Serasa Experian, Boa Vista SCPC,
# Quod — server/src/lib/creditBureau.ts) into Análise de Risco and the public score
# endpoint, on top of the internal + network-signal score. Requires a real commercial
# bureau account this repo can't provide; unset = score stays internal + network only.
BUREAU_API_URL=
BUREAU_API_KEY=

# Optional: enables real WhatsApp/SMS notifications via Twilio (server/src/lib/smsNotifier.ts)
# — aceite-deadline reminders (lib/aceiteReminder.ts) and every other notification event,
# for users who opt in from Perfil. When unset, messages are logged instead of sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# Optional: overrides the approximate per-million-token USD rate used to estimate cost in
# the admin "Uso de IA" panel (server/src/db/claudeUsage.ts) — the real token counts always
# come from the Anthropic API's own usage field, only the $/token conversion is a
# configurable estimate. Defaults to $3 input / $15 output per million tokens.
CLAUDE_COST_INPUT_PER_MTOK_USD=
CLAUDE_COST_OUTPUT_PER_MTOK_USD=

# Optional: enables a real judicial-records/litigation-history check (execuções,
# falência/recuperação judicial, protestos) by CNPJ, blended as a real signal into the
# Compliance AI Engine (server/src/lib/judicialRecords.ts). Requires a real commercial
# contract with a provider like Escavador or Jusbrasil this repo can't provide — there is
# no free official public API for this in Brazil (unlike OFAC's sanctions list). Unset =
# this factor is simply never added to the compliance score, nothing is faked.
JUDICIAL_RECORDS_API_URL=
JUDICIAL_RECORDS_API_KEY=

# Optional: max requests per minute per partner API key on /api/v1. Defaults to 60.
API_RATE_LIMIT_PER_MIN=

# Optional: comma-separated retry delays in ms for failed webhook deliveries.
# Defaults to "0,30000,300000,1800000" (immediate / 30s / 5min / 30min).
WEBHOOK_RETRY_DELAYS_MS=
