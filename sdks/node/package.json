{
  "name": "@lastro/sdk",
  "version": "1.0.0",
  "description": "Official Node.js/TypeScript SDK for the Lastro Partner API (/api/v1).",
  "private": true,
  "repository": { "type": "git", "url": "git+https://github.com/tytooenerg/dr.house.git", "directory": "sdks/node" },
  "bugs": "https://github.com/tytooenerg/dr.house/issues",
  "homepage": "https://github.com/tytooenerg/dr.house/tree/main/sdks/node#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
